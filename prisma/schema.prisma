// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  city      String?
  postalCode String?
  clientType String @default("particulier")
  billingType String @default("particulier")
  country    String?
  companyName String?
  siret      String?
  stripeCustomerId String?
  role      String   @default("user") // "user", "admin", "cashier", "preparation", "delivery"
  isActive  Boolean  @default(true)
  salary    Float?
  salaryType String?
  hoursPerWeek Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  cart      Cart?
  preferences UserPreference?
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  orderUpdates       Boolean  @default(true)
  promotions         Boolean  @default(false)
  newsletter         Boolean  @default(false)
  theme              String   @default("system")
  language           String   @default("fr")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  slug        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  unit        String   // e.g "kg", "piece"
  image       String?
  inStock     Boolean  @default(true)
  organic     Boolean  @default(false)
  supplier    String?
  origin      String?
  purchasePrice Float?
  margin      Float?
  currentStock Float      @default(0)
  minimumStock Float      @default(10)
  /// Prix promotionnel : quand il est défini, c'est lui le prix de vente effectif ;
  /// `price` devient l'ancien prix, affiché barré. null = pas de promo.
  promoPrice   Float?
  /// Dernière date de réapprovisionnement (posée par le bot lors d'un /reappro).
  lastRestockedAt DateTime?

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

model Composition {
  id          String   @id @default(cuid())
  name        String
  type        String   // e.g "jus", "soupe", "legumes-decoupes"
  description String?
  /// Prix de repli quand la composition n'a pas encore de taille définie.
  /// Dès qu'une CompositionSize existe, c'est elle qui fixe le prix.
  basePrice   Float
  imageUrl    String?

  sizes       CompositionSize[]
  options     CompositionOption[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

/// Format de vente d'une composition, avec son prix propre.
/// Un plateau de fruits n'est pas vendu au poids : chaque taille a un tarif fixe,
/// et non un multiplicateur appliqué à un prix de base.
model CompositionSize {
  id            String      @id @default(cuid())
  compositionId String
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)

  name          String      // "Petit", "Moyen", "Grand", "6 personnes"...
  price         Float
  description   String?     // "environ 400 g", "2 à 3 personnes"
  isDefault     Boolean     @default(false)
  order         Int         @default(0)

  /// Nombre d'ingrédients compris dans le prix, choisis librement par le client.
  /// Un smoothie « 2 fruits au choix » vaut 2 ici : les deux premiers sélectionnés sont
  /// inclus, les suivants sont facturés au tarif de l'ingrédient.
  /// 0 = pas de quota : la formule est fixe et suit `CompositionOption.includedByDefault`.
  includedChoices Int       @default(0)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([compositionId])
}

/// Ingrédient proposé sur une composition.
/// `includedByDefault` décrit la formule standard (compris dans le prix de la taille) ;
/// les autres sont des suppléments facturés `extraPrice`. Volontairement sans lien vers
/// Product : le tarif d'un ingrédient en plateau n'a rien à voir avec son prix au kilo.
model CompositionOption {
  id            String      @id @default(cuid())
  compositionId String
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)

  name          String      // "Mangue", "Fraise", "Gingembre"...
  extraPrice    Float       @default(0)
  includedByDefault Boolean @default(false)
  /// Un ingrédient de la formule standard peut être retiré par le client, sauf s'il
  /// définit la recette (la carotte d'un jus détox, par exemple).
  isRemovable   Boolean     @default(true)
  isActive      Boolean     @default(true)
  order         Int         @default(0)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([compositionId])
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  status          String    @default("pending") // "pending", "validated", "processing", "shipped", "delivered", "cancelled"
  total           Float
  carrier         String?
  trackingNumber  String?
  deliveryMethod  String?   // "livraison" or "retrait"
  deliveryDate    DateTime?
  deliverySlot    String?
  deliveryAddress String?
  deliveryCity    String?
  deliveryPostalCode String?
  phone           String?
  deliveryFee     Float     @default(0)
  pickupCode      String?   // Code for click & collect
  invoiceNumber   String?   @unique
  promoCode       String?
  discount        Float     @default(0)
  stripeSessionId String?

  items     OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  compositionId String?
  composition   Composition? @relation(fields: [compositionId], references: [id], onDelete: SetNull)

  quantity  Float
  priceAtPurchase Float // Capture price at the time of order
  customData Json? // personnalisation composition (taille, ingrédients) figée à la commande
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?     @unique // Rattache a un User auth
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // Pour les visiteurs non connectes
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  compositionId String?
  composition   Composition? @relation(fields: [compositionId], references: [id], onDelete: SetNull)

  quantity  Float      @default(1)
  customData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, compositionId])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  author      String   @default("Equipe Power")
  category    String?
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     String?
  duration    String?
  difficulty  String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // "percentage" or "fixed"
  value       Float     // e.g. 10 for 10% or 5 for 5€
  minOrder    Float     @default(0)
  maxUses     Int       @default(0) // 0 = unlimited
  currentUses Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  type        String   // "salary", "fuel", "rent", "electricity", "supply", "loss", "other"
  description String
  amount      Float
  date        DateTime
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Limiteur de débit adossé à la base (pas de service externe) : une ligne par clé
/// (« login:email », « forgot-ip:1.2.3.4 »…), remise à zéro à chaque nouvelle fenêtre.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt
}

model DeliverySlot {
  id          String   @id @default(cuid())
  date        DateTime
  startTime   String   // e.g "09:00"
  endTime     String   // e.g "12:00"
  maxOrders   Int      @default(10)
  currentOrders Int    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, startTime])
}
